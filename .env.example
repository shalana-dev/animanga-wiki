PORT=3000

# Opcional. Quantos saltos de proxy reverso existem na frente do servidor.
# Padrão: 1 (funciona para a maioria das hospedagens com um único proxy).
# TRUST_PROXY=1

# Opcional. Só defina se o frontend for hospedado em um domínio diferente
# do backend. Sem essa variável, requisições de outras origens são bloqueadas
# pelo navegador (comportamento seguro padrão).
# ALLOWED_ORIGIN=https://seusite.com
